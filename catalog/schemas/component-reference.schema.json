{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Component Reference",
  "type": "object",
  "required": ["id", "name", "brandProfileId", "sourceType", "sourceStatus", "sourceUrl", "reviewedAt", "platforms", "category", "summary", "anatomy", "states", "behavior", "accessibility", "tokens"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "brandProfileId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "sourceType": { "const": "public-guideline" },
    "sourceStatus": { "const": "基于公开设计规范" },
    "sourceUrl": { "type": "string", "format": "uri" },
    "reviewedAt": { "type": "string", "format": "date" },
    "platforms": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "category": { "type": "string" },
    "summary": { "type": "string" },
    "anatomy": { "type": "array", "items": { "type": "string" } },
    "states": { "type": "array", "items": { "type": "string" } },
    "behavior": { "type": "array", "items": { "type": "string" } },
    "accessibility": { "type": "array", "items": { "type": "string" } },
    "tokens": { "type": "object" },
    "do": { "type": "array", "items": { "type": "string" } },
    "dont": { "type": "array", "items": { "type": "string" } },
    "locales": {
      "type": "object",
      "properties": {
        "en": {
          "type": "object",
          "required": ["sourceStatus", "category", "summary", "anatomy", "states", "behavior", "accessibility", "do", "dont"]
        }
      }
    }
  },
  "additionalProperties": true
}
