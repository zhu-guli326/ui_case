{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Image2 UI case",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "name", "style", "category", "referenceImage", "prompt", "summary", "bestFor", "tags", "styleProfileIds"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "style": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "referenceImage": { "type": "string", "minLength": 1 },
    "prompt": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "bestFor": { "type": "string", "minLength": 1 },
    "tags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "styleProfileIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
    "locales": {
      "type": "object",
      "required": ["en"],
      "properties": { "en": { "$ref": "#/$defs/localizedCase" } }
    }
  },
  "$defs": {
    "localizedCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style", "reference", "prompt", "summary", "bestFor", "tags", "palette", "layout", "recipe"],
      "properties": {
        "style": { "type": "string", "minLength": 1 },
        "reference": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "bestFor": { "type": "string", "minLength": 1 },
        "tags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "palette": { "type": "string", "minLength": 1 },
        "layout": { "type": "string", "minLength": 1 },
        "recipe": { "$ref": "#/$defs/localizedRecipe" }
      }
    },
    "localizedRecipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principle", "image", "type", "components", "motion", "avoid"],
      "properties": {
        "principle": { "type": "string", "minLength": 1 },
        "image": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "components": { "type": "string", "minLength": 1 },
        "motion": { "type": "string", "minLength": 1 },
        "avoid": { "type": "string", "minLength": 1 }
      }
    }
  }
}
